APP_NAME=Nido
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000

# Completar localmente al inicializar Laravel; jamás pegar secretos en prompts.
DB_CONNECTION=pgsql
DB_HOST=CHANGE_ME_SUPABASE_HOST
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=CHANGE_ME_RUNTIME_ROLE
DB_PASSWORD=
DB_SSLMODE=verify-full
# Configurar search_path nido y el certificado CA en config/database.php.

# Solo servidor: bucket privado y credencial que no se distribuye a Flutter.
SUPABASE_URL=https://CHANGE_ME.supabase.co
SUPABASE_SERVER_SECRET=
SUPABASE_DOCUMENTS_BUCKET=nido-documents
SUPABASE_QUARANTINE_BUCKET=nido-quarantine
